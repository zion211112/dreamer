# Local-only settings for the APT-LABS identity prototype.
# Copy to .env and replace the secret before starting the server.
DATABASE_URL=postgres://apt_labs:local-only-change-me@127.0.0.1:54329/apt_labs
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-at-least-32-characters
BETTER_AUTH_URL=http://localhost:4200
# Exact browser origins allowed for Better Auth and same-origin API mutations.
# Keep this list limited to local app origins; do not use wildcards.
APT_EXTRA_TRUSTED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
PORT=3000
