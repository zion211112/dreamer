NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ---------------------------------------------------------------------------
# Local development identity.
#
# The prototype is still in development and has no connected backend, so sign-in
# runs on a local identity by default: /sign-in accepts any email and password
# and stores a signed cookie in the browser only. Nothing is written to a
# server, no account is created, and every action that would write a shared
# record stays disabled.
#
# Set DEV_AUTH_ENABLED=false to hand sign-in back to Supabase Auth and to let
# the app read and write shared Supabase records again.
# ---------------------------------------------------------------------------
DEV_AUTH_ENABLED=true
# ---------------------------------------------------------------------------
# Optional. Signs the local session cookie. Set a long random value in shared
# deployments. When it is unset a development fallback secret is used, which
# means the local session is not a secret.
# ---------------------------------------------------------------------------
# DEV_AUTH_SECRET=
# ---------------------------------------------------------------------------
# Vercel-only prototype shortcut. Set all three in the Vercel dashboard
# (Project → Settings → Environment Variables) for every environment that
# should offer one-click developer sign-in; leave them off elsewhere.
# Do NOT commit real values here — this file documents names only.
# ---------------------------------------------------------------------------
# DEV_SIGN_IN_EMAIL=skammba@gmail.com
# DEV_SIGN_IN_PASSWORD=apt-labs-dev-2026
