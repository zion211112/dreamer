{
  "name": "zeptepi",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && npm run build:investor-deck && npm run copy:investor-deck",
    "build:app": "tsc && vite build",
    "build:investor-deck": "npm install --prefix investor-deck --no-audit --no-fund && npm run build --prefix investor-deck/open-slide",
    "copy:investor-deck": "node scripts/copy-investor-deck.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:investor-deck": "npm run build:investor-deck && npx playwright test --project chromium tests/investor-deck.spec.ts",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "deploy": "npm run build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.47",
    "@ai-sdk/google": "^4.0.61",
    "@ai-sdk/openai": "^4.0.53",
    "@ai-sdk/react": "^4.0.90",
    "@internationalized/date": "^3.12.1",
    "@mcp-ui/client": "^7.1.1",
    "@mcp-ui/server": "^6.1.0",
    "@remixicon/react": "^4.9.0",
    "@semantic-components/ui": "^0.81.0",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/vue-query": "^5.108.2",
    "@trust0/identus-react": "^0.0.149",
    "@vitejs/plugin-vue": "^6.0.11",
    "@zanii/core": "^0.5.7",
    "@zanii/sdk": "^0.6.0",
    "ai": "^7.0.87",
    "clsx": "^2.1.1",
    "cytoscape": "^3.35.0",
    "date-fns": "^4.4.0",
    "motion": "^12.42.2",
    "pinia": "^4.1.0",
    "react-aria-components": "^1.17.0",
    "react-cmdk-base": "^0.12.0",
    "react-cytoscapejs": "^2.0.0",
    "react-sigma": "^1.2.35",
    "recharts": "^3.9.2",
    "regle": "^0.0.2",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vortx-gl": "^1.0.42",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5",
    "waltid-vue-components": "^1.1.2",
    "zod": "^4.6.7"
  },
