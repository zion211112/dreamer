{
  "name": "zeptepi",
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "postinstall": "npm install --prefix investor-deck --no-audit --no-fund",
    "dev": "vite",
    "build": "tsc && vite build && npm run build:investor-deck && npm run copy:investor-deck",
    "build:investor-deck": "npm run build --prefix investor-deck/open-slide",
    "copy:investor-deck": "node scripts/copy-investor-deck.mjs",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:investor-deck": "npm run build:investor-deck && npx playwright test --project chromium tests/investor-deck.spec.ts",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "deploy": "npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.3.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "aioli-design": "^0.7.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "pinia": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45",
    "vue-router": "^4.6.5",
    "wouter": "^3.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ark-ui/react": "^5.40.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "storybook": "^10.6.7",
    "typescript": "^5.6.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  }
}
