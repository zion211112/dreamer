{
  "name": "apt-labs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "concurrently -k -n api,web \"npm:serve:api\" \"npm:serve:web\"",
    "dev": "npm start",
    "build": "ng build",
    "typecheck": "tsc --noEmit",
    "test": "ng test --watch=false",
    "test:unit": "ng test --watch=false",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "skills:sync": "node scripts/sync-agent-skills.mjs",
    "deploy": "npm run build",
    "serve:api": "tsx watch src/server/index.ts",
    "serve:web": "ng serve",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local:up": "docker compose -f docker-compose.identity.yml up -d",
    "db:local:down": "docker compose -f docker-compose.identity.yml stop postgres"
  },
  "dependencies": {
    "@angular/common": "^22.3.0",
    "@angular/compiler": "^22.3.0",
    "@angular/core": "^22.3.0",
    "@angular/forms": "^22.3.0",
    "@angular/platform-browser": "^22.3.0",
    "@angular/router": "^22.3.0",
    "@angular/ssr": "^22.3.0",
    "@better-auth/drizzle-adapter": "^1.7.28",
    "@ngxpert/cmdk": "^3.0.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@spartan-ng/brain": "^1.10.0",
    "better-auth": "^1.7.28",
    "cytoscape": "^3.35.0",
    "dotenv": "^18.0.10",
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.3.0",
    "@angular/cli": "^22.3.0",
    "@angular/compiler-cli": "^22.3.0",
    "@playwright/test": "^1.65.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "concurrently": "^10.0.7",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "express": "^5.3.0",
    "jsdom": "^31.0.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vitest": "^4.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@parcel/watcher@2.6.0": true,
    "lmdb@3.5.9": true,
    "msgpackr-extract@3.0.7": true
  }
}
