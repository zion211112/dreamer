{
  "name": "W4 - Settle",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "settle",
        "responseMode": "onReceived",
        "responseData": "result"
      },
      "id": "webhook-settle",
      "name": "Settle Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "w4-settle-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "validate-action",
              "leftValue": "={{ $json.action }}",
              "rightValue": "settle",
              "operator": "equals"
            },
            {
              "id": "validate-payload",
              "leftValue": "={{ $json.payload }}",
              "rightValue": "",
              "operator": "exists"
            }
          ],
          "combinator": "and"
        },
        "errorMessage": "Invalid settle payload: missing action or payload field",
        "options": {}
      },
      "id": "validate-settle",
      "name": "Validate Settle",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300],
      "versionPin": []
    },
    {
      "parameters": {
        "url": "={{ $node['APT-LABS API'].apiBase }}/api/settle",
        "method": "POST",
        "jsonParameters": true,
        "options": {}
      },
      "id": "call-settle-api",
      "name": "Call Settle API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 200],
      "credentials": {
        "httpHeaderAuth": "aptlabs-api"
      }
    },
    {
      "parameters": {
        "url": "={{ $node['APT-LABS API'].apiBase }}/api/events",
        "method": "POST",
        "jsonParameters": true,
        "options": {}
      },
      "id": "record-settle-event",
      "name": "Record Settle Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 400],
      "credentials": {
        "httpHeaderAuth": "aptlabs-api"
      }
    }
  ],
  "connections": {
    "Settle Trigger": {
      "main": [[{ "node": "Validate Settle", "type": "main", "index": 0 }]]
    },
    "Validate Settle": {
      "main": [
        [
          { "node": "Call Settle API", "type": "main", "index": 0 }
        ],
        []
      ]
    },
    "Call Settle API": {
      "main": [[{ "node": "Record Settle Event", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "Africa/Nairobi"
  },
  "id": "w4-settle-workflow",
  "tags": ["aptlabs", "quality-orchestration", "settle"]
}
