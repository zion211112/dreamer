{
  "name": "W5 - Produce",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "produce",
        "responseMode": "onReceived",
        "responseData": "result"
      },
      "id": "webhook-produce",
      "name": "Produce Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 300],
      "webhookId": "w5-produce-trigger"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "validate-action",
              "leftValue": "={{ $json.action }}",
              "rightValue": "produce",
              "operator": "equals"
            },
            {
              "id": "validate-payload",
              "leftValue": "={{ $json.payload }}",
              "rightValue": "",
              "operator": "exists"
            }
          ],
          "combinator": "and"
        },
        "errorMessage": "Invalid produce payload: missing action or payload field",
        "options": {}
      },
      "id": "validate-produce",
      "name": "Validate Produce",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [500, 300],
      "versionPin": []
    },
    {
      "parameters": {
        "url": "={{ $node['APT-LABS API'].apiBase }}/api/produce",
        "method": "POST",
        "jsonParameters": true,
        "options": {}
      },
      "id": "call-produce-api",
      "name": "Call Produce API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 200],
      "credentials": {
        "httpHeaderAuth": "aptlabs-api"
      }
    },
    {
      "parameters": {
        "url": "={{ $node['APT-LABS API'].apiBase }}/api/events",
        "method": "POST",
        "jsonParameters": true,
        "options": {}
      },
      "id": "record-produce-event",
      "name": "Record Produce Event",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [750, 400],
      "credentials": {
        "httpHeaderAuth": "aptlabs-api"
      }
    }
  ],
  "connections": {
    "Produce Trigger": {
      "main": [[{ "node": "Validate Produce", "type": "main", "index": 0 }]]
    },
    "Validate Produce": {
      "main": [
        [
          { "node": "Call Produce API", "type": "main", "index": 0 }
        ],
        []
      ]
    },
    "Call Produce API": {
      "main": [[{ "node": "Record Produce Event", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "timezone": "Africa/Nairobi"
  },
  "id": "w5-produce-workflow",
  "tags": ["aptlabs", "quality-orchestration", "produce"]
}
