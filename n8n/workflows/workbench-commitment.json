{
  "name": "APT-LABS Workbench Commitment Flow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "workbench/commitment",
        "responseMode": "onReceived",
        "options": {}
      },
      "name": "Webhook - Commitment",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "collection": "commitments",
        "document": {
          "needId": "={{ $json.body.needId }}",
          "providerActorId": "={{ $json.body.providerActorId }}",
          "status": "accepted",
          "acceptedAt": "={{ $now }}",
          "deadline": "={{ $json.body.deadline }}"
        },
        "options": {}
      },
      "name": "Create Commitment Record",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [550, 300],
      "credentials": {
        "mongodbApi": "aptlabs-mongodb"
      }
    },
    {
      "parameters": {
        "operation": "update",
        "collection": "needs",
        "filter": { "needId": "={{ $json.body.needId }}" },
        "document": { "$set": { "status": "committed" } },
        "options": {}
      },
      "name": "Update Need Status",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [850, 300],
      "credentials": {
        "mongodbApi": "aptlabs-mongodb"
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "case": [
              {
                "value": "={{ $json.body.deadline }}",
                "operation": "isNotEmpty"
              }
            ]
          }
        }
      },
      "name": "Has Deadline?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [1050, 200]
    },
    {
      "parameters": {
        "operation": "create",
        "collection": "deadlines",
        "document": {
          "commitmentId": "={{ $json.body.needId }}",
          "deadline": "={{ $json.body.deadline }}",
          "status": "pending",
          "createdAt": "={{ $now }}"
        },
        "options": {}
      },
      "name": "Create Deadline Record",
      "type": "n8n-nodes-base.mongoDb",
      "typeVersion": 1,
      "position": [1300, 200],
      "credentials": {
        "mongodbApi": "aptlabs-mongodb"
      }
    }
  ],
  "connections": {
    "Webhook - Commitment": {
      "main": [[{ "node": "Create Commitment Record", "type": "main", "index": 0 }]]
    },
    "Create Commitment Record": {
      "main": [[{ "node": "Update Need Status", "type": "main", "index": 0 }]]
    },
    "Update Need Status": {
      "main": [[{ "node": "Has Deadline?", "type": "main", "index": 0 }]]
    },
    "Has Deadline?": {
      "main": [
        [
          {
            "node": "Create Deadline Record",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": true,
  "settings": {},
  "version": 1
}