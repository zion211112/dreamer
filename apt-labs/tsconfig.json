/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "compileOnSave": false,
  "compilerOptions": {
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve",
    "paths": {
      "@apt-labs/ontology": ["./libs/ontology/src/index.ts"],
      "@apt-labs/ontology/*": ["./libs/ontology/src/*"],
      "@apt-labs/domain": ["./libs/domain/src/index.ts"],
      "@apt-labs/domain/*": ["./libs/domain/src/*"],
      "@apt-labs/shared/ui": ["./libs/shared/ui/src/index.ts"],
      "@apt-labs/shared/ui/*": ["./libs/shared/ui/src/*"],
      "@apt-labs/shared/state": ["./libs/shared/state/src/index.ts"],
      "@apt-labs/shared/state/*": ["./libs/shared/state/src/*"],
      "@apt-labs/shell": ["./libs/shell/src/index.ts"],
      "@apt-labs/shell/*": ["./libs/shell/src/*"]
    }
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true
  },
  "files": [],
  "references": [
    {
      "path": "./tsconfig.app.json"
    },
    {
      "path": "./tsconfig.spec.json"
    }
  ]
}
